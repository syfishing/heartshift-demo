[sub_resource type="Shader" id="Shader_f72t2"]
code = "shader_type canvas_item;

uniform int columns = 80;        // match waveform's \"lines\"
uniform int rows = 80;           // match waveform's \"dot_matriz_size\"
uniform float line_width : hint_range(0.0, 0.5) = 0.05; // fraction of a cell
uniform vec4 line_color : source_color = vec4(0.0, 0.0, 0.0, 1.0);
uniform bool draw_outer_border = true; // draw the 0.0 and 1.0 edges too

void fragment() {
	vec2 cell = vec2(float(columns), float(rows));

	// Position within each cell, 0..1
	vec2 grid_uv = fract(UV * cell +0.5);

	// Distance to nearest cell edge (0 at edge, 0.5 at center), per axis
	vec2 dist = min(grid_uv, 1.0 - grid_uv);

	// A pixel is on a line if it's within half the line width of an edge
	float half_w = line_width * 0.5;
	bool on_line = (dist.x < half_w) || (dist.y < half_w);

	// fract() drops the line exactly at UV 1.0; optionally restore outer border
	if (draw_outer_border) {
		if (UV.x >= 1.0 - half_w || UV.x <= half_w ||
			UV.y >= 1.0 - half_w || UV.y <= half_w) {
			on_line = true;
		}
	}

	if (on_line) {
		COLOR = line_color;
	} else {
		discard;
	}
}"

