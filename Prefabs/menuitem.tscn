[sub_resource type="Shader" id="Shader_uhd87"]
code = "shader_type canvas_item;
uniform int columns = 80;
uniform int rows = 80;
uniform float line_width : hint_range(0.0, 0.5) = 0.05;
uniform vec4 line_color : source_color = vec4(0.0, 0.0, 0.0, 1.0);
uniform bool draw_outer_border = true;

void fragment() {
	vec4 modulate = COLOR; // node modulate/self_modulate (incl. inherited parent modulate)

	vec2 cell = vec2(float(columns), float(rows));
	vec2 grid_uv = fract(UV * cell + 0.5);
	vec2 dist = min(grid_uv, 1.0 - grid_uv);
	float half_w = line_width * 0.5;
	bool on_line = (dist.x < half_w) || (dist.y < half_w);

	if (draw_outer_border) {
		if (UV.x >= 1.0 - half_w || UV.x <= half_w ||
			UV.y >= 1.0 - half_w || UV.y <= half_w) {
			on_line = true;
		}
	}

	if (on_line) {
		COLOR = line_color;
		COLOR.a *= modulate.a;   // fade the lines with the node's opacity
	} else {
		discard;
	}
}"

