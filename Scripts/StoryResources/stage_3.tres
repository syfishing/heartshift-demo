metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_1g5uw"]
script = ExtResource("3_6imve")
character_id = "Teller"
text = "Not much time later, the man has been taken out of sight, and soon people seem to be going back to what they were doing beforehand."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_e2agj"]
script = ExtResource("3_6imve")
character_id = "Teller"
text = "Strange."
