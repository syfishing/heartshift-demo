[sub_resource type="Resource" id="Resource_3ine8"]
script = ExtResource("3_6imve")
character_id = "Teller"
text = "Clover and Lily arrive at the commotion, curious to see what is going on."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_6l2hg"]
script = ExtResource("3_6imve")
character_id = "Teller"
text = "The crowd is watching a group of security guards seemingly taking a man away."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_u2tva"]
script = ExtResource("3_6imve")
character_id = "Lily"
text = "Hey, what's going on here?"
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_lqf37"]
script = ExtResource("3_6imve")
character_id = "Teller"
text = "A security guard explains that the man had vandalized a booth nearby."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_lyobt"]
script = ExtResource("3_6imve")
character_id = "Teller"
text = "The booth's owner seems distressed, which Lily finds understandable for such a situation."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_xdvd7"]
script = ExtResource("3_6imve")
character_id = "Teller"
text = "..."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_1g5uw"]
script = ExtResource("3_6imve")
character_id = "Teller"
text = "Not much time later, the man has been taken out of sight, and soon people seem to be going back to what they were doing beforehand."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_e2agj"]
script = ExtResource("3_6imve")
character_id = "Teller"
text = "Strange."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_ov53a"]
script = ExtResource("3_6imve")
character_id = "Teller"
text = "..."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_ljurw"]
script = ExtResource("3_6imve")
character_id = "Teller"
text = "Lily and Clover continue to wander around, admiring the creations showcased on each booth."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_2f7h2"]
script = ExtResource("3_6imve")
character_id = "Teller"
text = "A particular art piece strikes Lily's eye: a canvas of a quiet, suburban row of houses."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_g7oej"]
script = ExtResource("3_6imve")
character_id = "Lily"
text = "Oh, look at the sky, Clover! They captured the sunset beautifully..."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_xw1pu"]
script = ExtResource("3_6imve")
character_id = "Teller"
text = "A mischievous smile creeps on Clover's face, one that he'd always make before teasing Lily."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_o6uit"]
script = ExtResource("3_6imve")
character_id = "Clover"
text = "Yeah, stunning."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_mun78"]
script = ExtResource("3_6imve")
character_id = "Clover"
text = "So stunning they forgot to write numbers."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_jlhv0"]
script = ExtResource("3_6imve")
character_id = "Teller"
text = "A frown appears on Lily's face as she leans closer to the canvas."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_vh6uw"]
script = ExtResource("3_6imve")
character_id = "Lily"
text = "What do you mean?"
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_cvj6d"]
script = ExtResource("3_6imve")
character_id = "Clover"
text = "The houses."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_ckh3w"]
script = ExtResource("3_6imve")
character_id = "Teller"
text = "He points a finger at the neat rows of mailboxes and doors painted along the curb."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_8ajhl"]
script = ExtResource("3_6imve")
character_id = "Clover"
text = "They didn't bother to paint the numbers on any of them. The plaques on the walls are just blank squares."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_0od15"]
script = ExtResource("3_6imve")
character_id = "Teller"
text = "Lily rolls her eyes."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_j0wbi"]
script = ExtResource("3_6imve")
character_id = "Lily"
text = "Oh, please! Artists do that all the time to save effort. Who wants to paint tiny numbers on thirty background houses? It doesn't matter anyway."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_g3yrs"]
script = ExtResource("3_6imve")
character_id = "Clover"
text = "Whatever you say."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_6wog7"]
script = ExtResource("3_6imve")
character_id = "Clover"
text = "Lazy, if you ask me."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

