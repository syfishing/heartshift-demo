[sub_resource type="Resource" id="Resource_u2tva"]
script = ExtResource("3_5p5lv")
character_id = "Teller"
text = "When the sun rose, they left the hotel and headed back to the art fair for day two."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_lqf37"]
script = ExtResource("3_5p5lv")
