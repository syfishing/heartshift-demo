[sub_resource type="Resource" id="Resource_3ine8"]
script = ExtResource("3_5p5lv")
character_id = "Teller"
text = "After a long day at the fair, Lily and Clover headed to a hotel where they had booked rooms to stay in for the night."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_6l2hg"]
script = ExtResource("3_5p5lv")
character_id = "Teller"
text = "...Upon entering their new hotel room, Lily plumps into bed."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_lqf37"]
script = ExtResource("3_5p5lv")
character_id = "Lily"
text = "Hey, Clover."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_ntf3o"]
script = ExtResource("3_5p5lv")
character_id = "Clover"
text = "mm?"
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_lyobt"]
script = ExtResource("3_5p5lv")
character_id = "Lily"
text = "Have you heard anything from Rivley lately?"
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_1g5uw"]
script = ExtResource("3_5p5lv")
character_id = "Clover"
text = "...no?"
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_e2agj"]
script = ExtResource("3_5p5lv")
character_id = "Lily"
text = "She's been isolating herself inside her home a lot lately, and i find it concerning."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_ov53a"]
script = ExtResource("3_5p5lv")
character_id = "Lily"
text = "...When i last saw her, she was really nervous about something too... I don't want her to fall into dangerou--"
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_ljurw"]
script = ExtResource("3_5p5lv")
character_id = "Clover"
text = "Look."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_2f7h2"]
script = ExtResource("3_5p5lv")
character_id = "Clover"
text = "I understand your concern, but this'll need to wait until we're back home."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_g7oej"]
script = ExtResource("3_5p5lv")
character_id = "Clover"
text = "We'll pay her a visit soon, alright? I also hope she's doing okay, but now is not the time."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_xw1pu"]
script = ExtResource("3_5p5lv")
character_id = "Lily"
text = "...Are you sure?"
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_o6uit"]
script = ExtResource("3_5p5lv")
character_id = "Clover"
text = "Yes, now go to bed. Our sleep schedule is messed up enough already..."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_u2tva"]
script = ExtResource("3_5p5lv")
character_id = "Teller"
text = "...The next day as the sun rose, they left the hotel and headed back to the art fair for day two."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_mun78"]
script = ExtResource("3_5p5lv")
character_id = "Teller"
text = "Not much time after arriving, something catches Lily's eye."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_jlhv0"]
script = ExtResource("3_5p5lv")
character_id = "Lily"
text = "...The booth is intact."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_vh6uw"]
script = ExtResource("3_5p5lv")
character_id = "Lily"
text = "No scratches, no cracks, no damage."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_cvj6d"]
script = ExtResource("3_5p5lv")
character_id = "Clover"
text = "...what are you on abou-"
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_ckh3w"]
script = ExtResource("3_5p5lv")
character_id = "Clover"
text = "Oh."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_8ajhl"]
script = ExtResource("3_5p5lv")
character_id = "Clover"
text = "Didn't know they were that good at repairing things."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_0od15"]
script = ExtResource("3_5p5lv")
character_id = "Lily"
text = "??????"
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_j0wbi"]
script = ExtResource("3_5p5lv")
character_id = "Clover"
text = "I mean, they probably replaced the-"
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_6wog7"]
script = ExtResource("3_5p5lv")
character_id = "Lily"
text = "What about the art though??"
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_g3yrs"]
script = ExtResource("3_5p5lv")
character_id = "Clover"
text = "[wave]I dunno![/wave] What else do you expect? Magic?"
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_uc00v"]
script = ExtResource("3_5p5lv")
character_id = "Lily"
text = "...I don't know, honestly."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_qdcmd"]
script = ExtResource("3_5p5lv")
character_id = "Clover"
text = "Don't worry about it."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

[sub_resource type="Resource" id="Resource_nbwj7"]
script = ExtResource("3_5p5lv")
character_id = "Clover"
text = "..."
metadata/_custom_type_script = "uid://xixdgkhinwgb"

